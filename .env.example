# MarketPulse Environment Variables Configuration

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketpulse_db
POSTGRES_USER=marketpulse_user
POSTGRES_PASSWORD=secure_password_here

# Runtime Settings
MARKETPULSE_ENV=development
MARKETPULSE_SEED=42
MARKETPULSE_LOG_LEVEL=INFO
MARKETPULSE_LOG_FORMAT=text

# Decision Thresholds
CAC_THRESHOLD_INR=350
TARGET_MARGIN_THRESHOLD_PCT=0.12

# Optional AI Explanation Layer API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
